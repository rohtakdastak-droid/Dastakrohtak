# Copy to .env.local and fill in. Never commit real keys.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional — maps/routing. If unset, app falls back to haversine with a user warning.
VITE_GOOGLE_MAPS_API_KEY=
VITE_MAPBOX_TOKEN=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# Only the PUBLIC key goes here (browser needs it). Private key stays server-side.
VITE_VAPID_PUBLIC_KEY=

# Public UPI VPA shown as fallback if admin has not uploaded a QR image yet.
VITE_FALLBACK_UPI_VPA=
VITE_FALLBACK_UPI_NAME=Dastak
