# Copy to .env.local and fill in. Never commit real keys.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Required for checkout: GOOGLE_MAPS_API_KEY in Supabase Edge Function secrets.
# Never prefix the server-side Google Routes key with VITE_. No distance fallback.

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# Only the PUBLIC key goes here (browser needs it). Private key stays server-side.
VITE_VAPID_PUBLIC_KEY=

# Public UPI VPA shown as fallback if admin has not uploaded a QR image yet.
VITE_FALLBACK_UPI_VPA=
VITE_FALLBACK_UPI_NAME=Dastak
